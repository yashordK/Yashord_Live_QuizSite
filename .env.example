# =====================================================================
# Live Quiz — environment variables
# Copy to `.env.local` for development. Set the same keys in the Vercel
# dashboard (Project → Settings → Environment Variables) for production.
# =====================================================================

# ---------------------------------------------------------------------
# Supabase — from Project Settings → API
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The anon key is public by design and ships to the browser. It is used
# ONLY to subscribe to the realtime broadcast channel. RLS is deny-all,
# so this key cannot read or write a single database row.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. This bypasses RLS.
# If this leaks, rotate it in the Supabase dashboard immediately.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------
# Host authentication
# ---------------------------------------------------------------------
# The password you type at /host/login. Make it long; the login URL will
# be visible to 200 students the moment you open it on a projector.
HOST_PASSWORD=change-me-to-something-long

# Signing secret for the host session cookie. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this instantly invalidates any existing host session.
HOST_SESSION_SECRET=replace-with-64-hex-chars

# How long a host login lasts before re-authentication is required.
HOST_SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------
# The 6-character join code students type on the join screen. Also names
# the realtime channel (session:CODE). Uppercase A-Z and 0-9.
SESSION_CODE=QUIZ01
SESSION_TITLE=The Yashord Quiz

# Hard cap on participants. 185 leaves headroom under the ~200 you expect
# for reconnects, duplicate tabs and the host's own devices.
JOIN_CAP=185

# Show the leaderboard automatically after every Nth question.
LEADERBOARD_INTERVAL=5

# ---------------------------------------------------------------------
# Roll numbers
#
# Validation is LENIENT by design: your three batches don't share one
# prefix, so we don't gate on prefix or range. What is NOT optional is
# NORMALIZATION — trim, uppercase, strip spaces/hyphens/underscores, then
# zero-pad the numeric tail. That is what makes "22cs 101", "22CS-101"
# and "22CS101" resolve to the same participant on rejoin. Without it a
# student who retypes their roll differently loses their entire score.
# ---------------------------------------------------------------------

# Zero-pad the trailing number to this many digits. Padding only ever
# pads UP, never truncates, so a longer roll passes through untouched.
# Set to 0 to disable padding entirely.
ROLL_PAD_LENGTH=3

# Sanity bounds on the canonical roll (rejects junk, not real students).
ROLL_MIN_LENGTH=3
ROLL_MAX_LENGTH=20

# ---------------------------------------------------------------------
# Anti-abuse
# ---------------------------------------------------------------------
# Join attempts allowed per IP per minute.
#
# Sized for a LECTURE HALL, not one person. Every student on campus wifi
# shares a single NAT'd public IP, so a small value here would admit a
# handful of students and hand everyone else "too many attempts". Treat
# it as a flood guard; the real limits are JOIN_CAP and joining_locked.
JOIN_RATE_LIMIT_PER_MIN=240

# Attempts allowed per ROLL NUMBER per minute. This is the tight one, and
# it's the right axis: it bounds one student retrying without affecting
# the 199 others sharing their IP. Counted after normalization.
JOIN_RATE_LIMIT_PER_ROLL_PER_MIN=6

# ---------------------------------------------------------------------
# Load test only (not needed in production)
# ---------------------------------------------------------------------
LOADTEST_BASE_URL=http://localhost:3000
